+    public void onCooldownUpdated(Context ctx, Entity e, FieldPath[] fieldPaths, int num) {
+        if (gameStartTime == 0 || e == null) return;
+        DTClass dt = e.getDtClass();
+        FieldPath cooldownPath = cooldown_paths.get(dt);
+        if (!cooldown_paths.containsKey(dt)) {
+            cooldownPath = dt.getFieldPathForName("m_fCooldown");
+            cooldown_paths.put(dt, cooldownPath);
+        }
+        if (cooldownPath == null) return;
+        boolean changed = false;
+        for (int i = 0; i < num; i++) {
+            if (cooldownPath.equals(fieldPaths[i])) {
+                changed = true;
+                break;
+            }
+        }
+        if (!changed) return;
+        Number rawEnd = e.getPropertyForFieldPath(cooldownPath);
+        float newEnd = rawEnd == null ? 0f : rawEnd.floatValue();
+        float oldEnd = cooldown_tracking.getOrDefault(e.getIndex(), 0f);
+        cooldown_tracking.put(e.getIndex(), newEnd);
+        if (newEnd <= oldEnd || newEnd <= 0f) return;
+        // Current Source 2 replays expose the remaining cooldown duration
+        // here (not a stable absolute match clock). Treating it as an end
+        // timestamp makes every in-game cooldown negative.
+        float remaining = newEnd;
+        Integer ownerSlot = cooldown_owner_slots.get(e.getIndex());
+        String actionName = cooldown_resource_names.get(e.getIndex());
+        if (remaining <= 0f || ownerSlot == null || actionName == null) return;
+        Entry cooldownEntry = new Entry(time);
+        cooldownEntry.type = "DOTA_COOLDOWN_START";
+        cooldownEntry.slot = ownerSlot;
+        cooldownEntry.targetname = cooldown_owner_heroes.get(e.getIndex());
+        cooldownEntry.valuename = actionName;
+        cooldownEntry.floatValue = remaining;
+        cooldownEntry.booleanValue = actionName.startsWith("item_");
+        output(cooldownEntry);
+    }
